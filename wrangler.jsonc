{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "discord-alarm",
    "main": "worker/index.ts",
    "compatibility_date": "2026-09-19",
    "compatibility_flags": ["nodejs_compat"],
    "vars": {
        "ALARM_TIME_ZONE": "Asia/Tokyo",
        "ALARM_VOLUME_PERCENT": "35",
        "ALARM_SNOOZE_LIMIT": "3",
        "ALARM_PREVIEW_SECONDS": "30"
    },
    "containers": [
        {
            "class_name": "AlarmContainer",
            "image": "./Dockerfile",
            "instance_type": "basic",
            "max_instances": 1
        }
    ],
    "durable_objects": {
        "bindings": [
            { "name": "ALARM_CONTAINER", "class_name": "AlarmContainer" }
        ]
    },
    "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["AlarmContainer"] }
    ],
    "d1_databases": [
        {
            "binding": "ALARM_DB",
            "database_name": "discord-alarm",
            "database_id": "00000000-0000-0000-0000-000000000000",
            "migrations_dir": "migrations"
        }
    ]
}
