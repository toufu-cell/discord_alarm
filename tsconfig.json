{
    "compilerOptions": {
        "target": "ES2024",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "erasableSyntaxOnly": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "types": ["node", "@cloudflare/workers-types"]
    },
    "include": ["src/**/*.ts", "test/**/*.ts"]
}
