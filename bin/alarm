#!/bin/sh
set -eu
root=$(CDPATH= cd -- "${0%/*}/.." && pwd)
PATH=/opt/homebrew/opt/node@24/bin:/usr/local/opt/node@24/bin:/opt/homebrew/bin:/usr/local/bin:${PATH:-}:/usr/bin:/bin:/usr/sbin:/sbin
export PATH
if [ "${NODE_ENV:-}" = test ] && [ "${ALARM_TEST_GATEWAY:-}" = 1 ]; then
    exec node "$root/src/alarm-cli.ts" "$@"
fi
exec node --env-file-if-exists="$root/.env" "$root/src/alarm-cli.ts" "$@"
