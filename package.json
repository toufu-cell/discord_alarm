{
    "name": "discord-alarm",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24.0.0"
    },
    "packageManager": "npm@11.11.0",
    "scripts": {
        "start": "node --env-file=.env src/index.ts",
        "diagnose": "node --env-file-if-exists=.env src/diagnose.ts",
        "typecheck": "tsc --noEmit",
        "test": "node --test --test-concurrency=1 test/*.test.ts",
        "check": "npm run typecheck && npm test"
    },
    "dependencies": {
        "@discordjs/voice": "0.19.2",
        "discord.js": "14.27.0"
    },
    "devDependencies": {
        "@types/node": "24.13.6",
        "typescript": "5.9.3"
    }
}
